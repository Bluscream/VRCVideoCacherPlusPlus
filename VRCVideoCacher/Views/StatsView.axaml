<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VRCVideoCacher.ViewModels"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:l="using:Jeek.Avalonia.Localization"
             x:Class="VRCVideoCacher.Views.StatsView"
             x:DataType="vm:StatsViewModel"
             x:CompileBindings="True">

    <Grid RowDefinitions="Auto, Auto, Auto, *">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="10">
            <TextBlock Text="{l:Localize Stats}" FontSize="24" FontWeight="Bold"/>
            <Button Grid.Column="1" Command="{Binding RefreshCommand}" ToolTip.Tip="{l:Localize Refresh}">
                <mi:MaterialIcon Kind="Refresh" Width="20" Height="20"/>
            </Button>
        </Grid>

        <!-- Summary tiles -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="10,0">
            <Border Background="#252525" CornerRadius="4" Padding="12" Margin="0,0,5,0">
                <StackPanel>
                    <TextBlock Text="{l:Localize CacheHitRate}" FontSize="12" Foreground="#888888"/>
                    <TextBlock Text="{Binding HitRateText}" FontSize="22" FontWeight="Bold" Foreground="#81C784" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="#252525" CornerRadius="4" Padding="12" Margin="5,0">
                <StackPanel>
                    <TextBlock Text="{l:Localize BandwidthSaved}" FontSize="12" Foreground="#888888"/>
                    <TextBlock Text="{Binding BytesSavedText}" FontSize="22" FontWeight="Bold" Foreground="#64B5F6" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="#252525" CornerRadius="4" Padding="12" Margin="5,0">
                <StackPanel>
                    <TextBlock Text="{l:Localize CacheHits}" FontSize="12" Foreground="#888888"/>
                    <TextBlock Text="{Binding CacheHitsText}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="#252525" CornerRadius="4" Padding="12" Margin="5,0,0,0">
                <StackPanel>
                    <TextBlock Text="{l:Localize TotalPlays}" FontSize="12" Foreground="#888888"/>
                    <TextBlock Text="{Binding TotalPlaysText}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Caveat: hits on since-evicted videos have no size to attribute -->
        <TextBlock Grid.Row="2" Text="{Binding BytesSavedCaveat}"
                   IsVisible="{Binding BytesSavedCaveat, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   FontSize="11" Foreground="#888888" TextWrapping="Wrap" Margin="10,8,10,0"/>

        <!-- Most replayed -->
        <Grid Grid.Row="3" RowDefinitions="Auto, *" Margin="10,12,10,0">
            <TextBlock Grid.Row="0" Text="{l:Localize MostReplayed}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <ListBox Grid.Row="1" ItemsSource="{Binding TopVideos}" Background="#1a1a1a">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:TopVideoViewModel">
                        <Border Margin="2" Background="#252525" CornerRadius="4" Padding="8">
                            <Grid ColumnDefinitions="*, Auto, Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayTitle}" FontSize="14" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                                    <TextBlock Text="{Binding VideoId}" FontSize="11" Foreground="#888888" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="10,0"
                                           Foreground="#888888" FontSize="11"
                                           Text="{Binding LastWatchedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <mi:MaterialIcon Kind="ContentSaveOff" Width="16" Height="16" Foreground="#888888"
                                                     ToolTip.Tip="{l:Localize NoLongerCached}"
                                                     IsVisible="{Binding !IsStillCached}"/>
                                    <TextBlock Text="{Binding WatchCount}" FontSize="18" FontWeight="Bold" Foreground="#64B5F6"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
