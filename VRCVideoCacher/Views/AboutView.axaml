<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:l="using:Jeek.Avalonia.Localization"
             xmlns:vm="clr-namespace:VRCVideoCacher.ViewModels"
             xmlns:views="clr-namespace:VRCVideoCacher.Views"
             xmlns:controls="clr-namespace:VRCVideoCacher.Controls"
             x:Class="VRCVideoCacher.Views.AboutView"
             x:DataType="vm:AboutViewModel">

    <ScrollViewer>
        <StackPanel Spacing="20" Margin="10">

            <!-- Header -->
            <TextBlock Text="{l:Localize About}" FontSize="24" FontWeight="Bold"/>

            <!-- Plus Fork -->
            <Border Background="#2d2d2d" CornerRadius="8" Padding="20">
                <StackPanel Spacing="15">
                    <TextBlock FontSize="16">
                        <Run Text="{l:Localize VRCVideoCacherPlus}" FontWeight="SemiBold"/>
                        <Run Text=" "/>
                        <Run Text="{Binding Version}"/>
                    </TextBlock>

                    <TextBlock Text="{Binding PlusAuthor}" Foreground="#AAAAAA"/>

                    <StackPanel Orientation="Horizontal" Spacing="15">
                        <Button Click="OnGitHubClick" ToolTip.Tip="GitHub">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <mi:MaterialIcon Kind="Github" Width="24" Height="24"/>
                                <TextBlock Text="GitHub" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Message of the day. Hidden entirely when the API returned nothing. -->
            <Border Background="#2d2d2d" CornerRadius="8" Padding="20" IsVisible="{Binding HasMotd}">
                <StackPanel Spacing="10">
                    <TextBlock Text="{l:Localize MessageOfTheDay}" FontWeight="SemiBold" FontSize="16"/>
                    <!-- Do not also set Text here: Text and Inlines are mutually exclusive. -->
                    <TextBlock controls:MarkdownText.Text="{Binding Motd}"
                               TextWrapping="Wrap"
                               Foreground="#DDDDDD"/>
                </StackPanel>
            </Border>

            <!-- Stats -->
            <Border Background="#2d2d2d" CornerRadius="8" Padding="20">
                <views:StatsView DataContext="{Binding Stats}"/>
            </Border>

            <!-- Report an Issue -->
            <Border Background="#2d2d2d" CornerRadius="8" Padding="20">
                <StackPanel Spacing="15">
                    <TextBlock Text="{l:Localize ReportAnIssue}" FontWeight="SemiBold" FontSize="16"/>

                    <StackPanel Orientation="Horizontal" Spacing="15">
                        <Button ToolTip.Tip="{l:Localize OpenIssueOnGitHub}" Click="OnGitHubIssueClick">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <mi:MaterialIcon Kind="Github" Width="24" Height="24"/>
                                <TextBlock Text="{l:Localize OpenIssueOnGitHub}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
